SITE_ROOT=../../instances/schlor
CHAT_DB=../../instances/schlor-data/chat.sqlite
EDITOR_SESSION_SECRET=replace-with-a-long-random-string
EDITOR_DEV_AUTH=1
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1
WEBSITE_ALLOW_PUBLISH=0
LLM_VISION=
# A browser is optional. The Docker image has one (BROWSER_PATH). BROWSER_URL points at a Chromium in another container instead.
BROWSER_URL=
BROWSER_PATH=
BROWSER_NO_SANDBOX=0
LLM_CONTENT_MODEL=
LLM_THINKING=
# The address visitors use, such as https://schlor.org. The deployment sets it. It makes the sitemap and canonical addresses.
SITE_URL=

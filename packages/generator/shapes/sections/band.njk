{% if band and band.title %}
<section class="mx-auto max-w-5xl px-6 py-12">
  <div class="bg-coral px-6 py-8 text-white">
    <h2 class="font-serif text-3xl">{{ band.title }}</h2>
    {% if band.text %}<p class="mt-3 max-w-3xl">{{ band.text }}</p>{% endif %}
    {% if band.href %}<a class="mt-4 inline-block bg-gold px-4 py-2 text-ink" href="{{ band.href }}">{{ band.label or band.href }}</a>{% endif %}
  </div>
</section>
{% endif %}

{% if groups and groups.length %}
<section class="mx-auto max-w-5xl px-6 py-12">
  {% if section.heading and section.heading[lang] %}<h2 class="font-serif text-3xl text-teal">{{ section.heading[lang] }}</h2>{% endif %}
  {% for group in groups %}
  <h2 class="mt-10 font-serif text-2xl text-teal">{{ group.title }}</h2>
  <ul class="mt-4 grid gap-4 md:grid-cols-3">
    {% for item in group.items %}
    <li class="border border-navy/10 p-3">
      {% if item.src %}
      <a href="{{ item.href or item.src }}"><img class="h-40 w-full object-cover" src="{{ item.src }}" alt="{{ item.label or '' }}"></a>
      {% endif %}
      {% if item.label %}<a class="mt-2 block text-sm text-coral" href="{{ item.href or item.src }}">{{ item.label }}</a>{% endif %}
    </li>
    {% endfor %}
  </ul>
  {% endfor %}
</section>
{% endif %}

{% extends "shell.njk" %}
{% block body %}
<article class="mx-auto max-w-text px-6 py-12">
  <h1 class="font-serif text-4xl text-heading">{{ title }}</h1>
  <p class="mt-4 text-muted">{{ place }}{% if address %} · {{ address }}{% endif %}</p>
  <ul class="mt-4 list-disc pl-5">
    {% for date in dates %}
    <li><time datetime="{{ date.start }}">{{ date.start | formatDay(lang) }}</time>{% if date.end %} – <time datetime="{{ date.end }}">{{ date.end | formatDay(lang) }}</time>{% endif %}</li>
    {% endfor %}
  </ul>
  {% for field in shownFields %}
  <p class="mt-2">{{ field.label }}: {{ field.value }}</p>
  {% endfor %}
  <div class="prose mt-8">{{ body | safe }}</div>
</article>
{% endblock %}

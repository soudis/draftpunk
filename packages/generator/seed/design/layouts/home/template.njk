{% extends "shell.njk" %}
{% block body %}
<section class="bg-navy px-6 py-16 text-white">
  <div class="mx-auto grid max-w-5xl gap-8 md:grid-cols-2 md:items-center">
    <div>
      <h1 class="font-serif text-5xl">{{ title }}</h1>
      {% if slots.lede %}<p class="mt-4 text-xl">{{ slots.lede }}</p>{% endif %}
    </div>
    {% if slots.hero_image %}<img class="max-h-80 w-full object-cover" src="{{ slots.hero_image }}" alt="">{% endif %}
  </div>
</section>
{% if slots.body %}<div class="prose mx-auto mt-8 max-w-3xl px-6">{{ slots.body }}</div>{% endif %}
{% if slots.cards and slots.cards.length %}
<section class="mx-auto max-w-5xl px-6 py-12">
  <ul class="grid gap-6 md:grid-cols-3">
    {% for card in slots.cards %}
    <li class="border border-navy/10">
      {% if card.image %}<a href="{{ card.href }}"><img class="h-40 w-full object-cover" src="{{ card.image }}" alt=""></a>{% endif %}
      <div class="p-4">
        <h3 class="font-serif text-xl text-teal"><a href="{{ card.href }}">{{ card.title }}</a></h3>
        {% if card.text %}<p class="mt-2 text-sm">{{ card.text }}</p>{% endif %}
      </div>
    </li>
    {% endfor %}
  </ul>
</section>
{% endif %}
{% if slots.band.title %}
<section class="mx-auto max-w-5xl px-6 py-12">
  <div class="bg-coral px-6 py-8 text-white">
    <h2 class="font-serif text-3xl">{{ slots.band.title }}</h2>
    {% if slots.band.text %}<p class="mt-3 max-w-3xl">{{ slots.band.text }}</p>{% endif %}
    {% if slots.band.href %}<a class="mt-4 inline-block bg-gold px-4 py-2 text-ink" href="{{ slots.band.href }}">{{ slots.band.label or slots.band.href }}</a>{% endif %}
  </div>
</section>
{% endif %}
{% if news and news.length %}
<section class="mx-auto max-w-5xl px-6 py-12">
  <h2 class="font-serif text-3xl text-teal">{{ labels.news }}</h2>
  <ul class="mt-4 space-y-3">
    {% for item in news %}
    <li><a class="text-coral" href="{{ item.href }}">{{ item.title }}</a> <span class="text-sm text-navy/70">{{ item.date }}</span></li>
    {% endfor %}
  </ul>
</section>
{% endif %}
{% if upcoming and upcoming.length %}
<section class="mx-auto max-w-5xl px-6 py-12">
  <h2 class="font-serif text-3xl text-teal">{{ labels.upcoming }}</h2>
  <ul class="mt-4 space-y-3">
    {% for item in upcoming %}
    <li><a class="text-coral" href="{{ item.href }}">{{ item.title }}</a>{% if item.place %} · {{ item.place }}{% endif %}</li>
    {% endfor %}
  </ul>
</section>
{% endif %}
{% endblock %}

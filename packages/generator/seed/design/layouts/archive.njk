{% extends "shell.njk" %}
{% block body %}
<section class="mx-auto max-w-3xl px-6 py-12">
  <h1 class="font-serif text-4xl text-teal">{{ title }}</h1>
  <ul class="mt-8 space-y-4">
    {% for item in items %}
    <li>
      <a class="text-lg text-coral" href="{{ item.href }}">{{ item.title }}</a>
      {% if item.date %}<span class="ml-2 text-sm text-navy/70">{{ item.date }}</span>{% endif %}
    </li>
    {% endfor %}
  </ul>
</section>
{% endblock %}

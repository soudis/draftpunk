<!doctype html>
<html lang="{{ lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title | plain }} · {{ name }}</title>
  <link rel="stylesheet" href="/assets/styles.css">
  {% for item in alternates %}
  <link rel="alternate" hreflang="{{ item.hreflang }}" href="{{ item.href }}">
  {% endfor %}
</head>
<body class="bg-page text-ink font-sans">
  <a class="skip-link" href="#main">{{ labels.skip }}</a>
  <header class="border-b border-border">
    <div class="mx-auto flex max-w-content flex-wrap items-center justify-between gap-4 px-6 py-4">
      <a class="font-serif text-2xl text-heading" href="{{ prefix }}/">{{ name }}</a>
      <input type="checkbox" id="menu-toggle" class="peer sr-only">
      <label for="menu-toggle" class="cursor-pointer border border-border px-3 py-1 text-sm uppercase tracking-wide md:hidden">{{ labels.menu }}</label>
      <nav aria-label="{{ labels.menu }}" class="hidden w-full flex-col gap-3 text-sm uppercase tracking-wide peer-checked:flex md:flex md:w-auto md:flex-row md:flex-wrap md:items-start md:gap-x-6 md:gap-y-2">
        {% for item in nav %}
          {% if item.children %}
          <div class="menu-group">
            <a class="hover:text-link" href="{{ item.href }}">{{ item.label }}</a>
            <ul class="submenu normal-case tracking-normal">
              {% for child in item.children %}
              <li><a class="hover:text-link" href="{{ child.href }}">{{ child.label }}</a></li>
              {% endfor %}
            </ul>
          </div>
          {% else %}
          <a class="hover:text-link" href="{{ item.href }}">{{ item.label }}</a>
          {% endif %}
        {% endfor %}
        {% for item in alternates %}
        <a class="text-link" href="{{ item.href }}">{{ item.label }}</a>
        {% endfor %}
      </nav>
    </div>
  </header>
  <main id="main">
    {% block body %}{% endblock %}
  </main>
  <footer class="mt-16 bg-surface px-6 py-8 text-on-surface">
    <div class="mx-auto flex max-w-content flex-wrap gap-6 text-sm">
      {% for item in footer %}
      <a href="{{ item.href }}">{{ item.label }}</a>
      {% endfor %}
      <span class="ml-auto">© {{ year }} {{ name }}</span>
    </div>
  </footer>
</body>
</html>

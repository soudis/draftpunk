{
  "name": "draftpunk",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @schlor/editor dev",
    "build": "pnpm --filter @schlor/editor build",
    "test": "pnpm --filter @schlor/generator test && pnpm --filter @schlor/editor test",
    "generate": "pnpm --filter @schlor/generator generate",
    "import": "pnpm --filter @schlor/importer run --",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "typescript": "^5.9.3"
  }
}
